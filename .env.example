# Copy to `.env.local` and fill in. Nothing here is required for `npm run dev` to work —
# the site degrades gracefully when a value is missing (see the README).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute base URL, no trailing slash. Drives canonical URLs, sitemap.xml,
# robots.txt and the Open Graph / Twitter card URLs.
NEXT_PUBLIC_SITE_URL=https://madcustomcars.com

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# Digits only, including country code, no "+" and no spaces. Used to build every
# wa.me link on the site, each with a prefilled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=16893674674

# ---------------------------------------------------------------------------
# Booking email (Resend)
# ---------------------------------------------------------------------------
# Get a key at https://resend.com/api-keys. Without it the booking form still
# works end to end — the submission is logged server-side and the customer sees
# the fallback message with the phone number and WhatsApp link.
RESEND_API_KEY=

# Where booking notifications are delivered.
BOOKING_TO_EMAIL=madcustomfl@outlook.com

# The From address. Must be on a domain you have verified in Resend. The default
# below only works once madcustomcars.com is verified there; until then Resend
# accepts onboarding@resend.dev for testing.
BOOKING_FROM_EMAIL="MAD Custom <bookings@madcustomcars.com>"

# Where messages from the /contact form are delivered. Defaults to BOOKING_TO_EMAIL
# when left blank, so set it only if the two should go to different inboxes.
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Instagram (optional)
# ---------------------------------------------------------------------------
# A long-lived access token for the @madcustomfl account, from the Instagram API with
# Instagram Login (Business or Creator account) — Instagram Basic Display was shut down
# in December 2024. Shows the latest reels, playable on the site, above a live grid.
# Expires after 60 days unless refreshed; see "Connecting Instagram" in the README.
# Leave blank to use the 12 bundled fallback images and no reels.
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# GoHighLevel (optional)
# ---------------------------------------------------------------------------
# The funnel pages (/services -> /quote, /book, /consultation) use GHL's own
# form and calendar widgets and need nothing here.
#
# These forward the site's OWN forms — the homepage build sheet and /contact —
# into the GHL CRM too. In GHL: Automation -> Workflows -> new workflow ->
# trigger "Inbound Webhook", copy its URL here, then map the incoming fields
# (first_name, last_name, email, phone, selected_services, ...) to the contact.
# Leave blank to use email only.
GHL_BOOKING_WEBHOOK_URL=
GHL_CONTACT_WEBHOOK_URL=
